<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ec.edu.monster.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Misma paleta que los demás clientes (EstilosUI del cliente de escritorio). -->
            <Color x:Key="Fondo">#F1F4F8</Color>
            <Color x:Key="Tinta">#1D2939</Color>
            <Color x:Key="AzulMarino">#183257</Color>
            <Color x:Key="AzulHover">#234470</Color>
            <Color x:Key="Suave">#E8EDF4</Color>
            <Color x:Key="Gris">#5B697A</Color>
            <Color x:Key="Borde">#D3DBE5</Color>
            <Color x:Key="Blanco">#FCFDFE</Color>
            <Color x:Key="Error">#B42318</Color>

            <Style x:Key="Tarjeta" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
                <Setter Property="Stroke" Value="{StaticResource Borde}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            </Style>

            <Style x:Key="Campo" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
                <Setter Property="Stroke" Value="{StaticResource Borde}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="MinimumHeightRequest" Value="50" />
            </Style>

            <Style x:Key="Etiqueta" TargetType="Label">
                <Setter Property="Margin" Value="0,14,0,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Gris}" />
            </Style>

            <Style x:Key="BotonPrincipal" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AzulMarino}" />
                <Setter Property="TextColor" Value="{StaticResource Blanco}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinimumHeightRequest" Value="52" />
            </Style>

            <Style x:Key="BotonTexto" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource AzulMarino}" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="BotonTonal" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Suave}" />
                <Setter Property="TextColor" Value="{StaticResource AzulMarino}" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="20,8" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource Tinta}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource Tinta}" />
                <Setter Property="TitleColor" Value="{StaticResource Gris}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
