@model LoginModelo
@{
    ViewData["Titulo"] = "Iniciar sesión · Conversor";
}
<div class="screen-layout screen-layout--auth"><section class="screen-content"><main class="panel auth">
    <p class="eyebrow">Conversor de unidades</p>
    <h1>Inicia sesión</h1>
    <p class="muted">Convierte longitud, masa y temperatura con el servicio REST.</p>

    @if (Model.Error != null)
    {
        <div class="notice error">@Model.Error</div>
    }
    @if (Model.Aviso != null)
    {
        <div class="notice success">@Model.Aviso</div>
    }

    <form method="post" asp-controller="Acceso" asp-action="Login">
        <label for="usuario">Usuario</label>
        <input id="usuario" name="usuario" value="@Model.Usuario" autocomplete="username" required maxlength="100">
        <label for="clave">Clave</label>
        <input id="clave" name="clave" type="password" autocomplete="current-password" required maxlength="200">
        <button>Entrar</button>
    </form>
    <p><a class="link-button" asp-controller="Acceso" asp-action="Recuperar">Recuperar clave</a></p>
</main></section><aside class="visual-sidebar"><img src="~/img/monster.jpg" alt="Monster usando una computadora"></aside></div>
