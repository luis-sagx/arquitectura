<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ec.edu.monster.vista.ConversionesPage"
             BackgroundColor="{StaticResource Fondo}">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Cabecera -->
        <Grid ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource AzulMarino}" Padding="20,12,8,12">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="MONSTER" CharacterSpacing="3" FontAttributes="Bold" FontSize="12"
                       TextColor="{StaticResource Borde}" />
                <Label Text="Conversor de unidades" FontAttributes="Bold" FontSize="20"
                       TextColor="{StaticResource Blanco}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" x:Name="cerrarSesion" Text="Salir" BackgroundColor="Transparent"
                    TextColor="{StaticResource Blanco}" FontAttributes="Bold" Clicked="AlCerrarSesion" />
        </Grid>

        <ActivityIndicator Grid.Row="1" x:Name="progreso" IsVisible="False" IsRunning="False"
                           Color="{StaticResource AzulMarino}" HeightRequest="28" Margin="0,6,0,0" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="0">
                <Image Source="monster_banner.jpg" HeightRequest="220" Aspect="AspectFill"
                       SemanticProperties.Description="Monster usando una computadora" />
            <VerticalStackLayout Padding="20" Spacing="0">
                <Border Style="{StaticResource Tarjeta}" Padding="20,6,20,20">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Categoría" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource Campo}">
                            <Picker x:Name="categoria" Title="Categoría" SelectedIndexChanged="AlCambiarCategoria" />
                        </Border>

                        <Label Text="De" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource Campo}">
                            <Picker x:Name="origen" Title="Unidad de origen" SelectedIndexChanged="AlCambiarUnidad" />
                        </Border>

                        <Button x:Name="intercambiar" Text="⇅  Intercambiar" Style="{StaticResource BotonTonal}"
                                HorizontalOptions="Center" Margin="0,10,0,0" Clicked="AlIntercambiar" />

                        <Label Text="A" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource Campo}">
                            <Picker x:Name="destino" Title="Unidad de destino" SelectedIndexChanged="AlCambiarUnidad" />
                        </Border>

                        <Label Text="Valor a convertir" Style="{StaticResource Etiqueta}" Margin="0,18,0,6" />
                        <Border Style="{StaticResource Campo}">
                            <Entry x:Name="valor" Keyboard="Numeric" ReturnType="Done" Placeholder="0"
                                   Completed="AlConvertir" />
                        </Border>

                        <Grid Margin="0,18,0,0" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" x:Name="convertir" Text="Convertir" Style="{StaticResource BotonPrincipal}"
                                    Clicked="AlConvertir" />
                            <Button Grid.Column="1" x:Name="verCatalogo" Text="Ver catalogo" Style="{StaticResource BotonTonal}"
                                    Clicked="AlConsultarCatalogo" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Tarjeta}" BackgroundColor="{StaticResource AzulMarino}"
                        StrokeThickness="0" Padding="20" Margin="0,16,0,0">
                    <VerticalStackLayout>
                        <Label Text="Resultado" FontAttributes="Bold" FontSize="14" TextColor="White" />
                        <Label x:Name="resultado" Text="—" FontAttributes="Bold" FontSize="28" Margin="0,6,0,0"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="estado" FontSize="14" Margin="0,14,0,0" TextColor="{StaticResource Gris}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
