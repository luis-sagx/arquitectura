<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="ec.edu.monster.vista.VistaHtml" %><%!
private String esc(String x){return VistaHtml.escapar(x);}%>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Recuperar clave</title><link rel="stylesheet" href="<%=request.getContextPath()%>/recursos/css/estilos.css"></head><body><div class="screen-layout screen-layout--auth"><section class="screen-content"><main class="panel auth"><p class="eyebrow">Conversor de unidades</p><h1>Recupera tu clave</h1>
<%if(request.getAttribute("error")!=null){%><div class="notice error"><%=esc((String)request.getAttribute("error"))%></div><%}if(request.getAttribute("exito")!=null){%><div class="notice success"><%=esc((String)request.getAttribute("exito"))%></div><%}%>
<form method="post" action="<%=request.getContextPath()%>/recuperar-clave"><input type="hidden" name="csrf" value="<%=esc((String)session.getAttribute("csrf"))%>"><label>Usuario</label><input name="usuario" autocomplete="username" required><label>Nueva clave</label><input name="clave" type="password" autocomplete="new-password" required><label>Confirma la clave</label><input name="confirmar" type="password" autocomplete="new-password" required><button>Actualizar clave</button></form><p><a class="link-button link-button--back" href="<%=request.getContextPath()%>/login">Volver al inicio</a></p></main></section><aside class="visual-sidebar"><img src="<%=request.getContextPath()%>/recursos/img/monster.jpg" alt="Monster usando una computadora"></aside></div></body></html>
